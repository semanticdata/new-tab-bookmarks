{
  "manifest_version": 3,
  "name": "New Tab Bookmarks",
  "version": "1.4.0",
  "description": "New tab filled with your own bookmarks and a place to write notes.",
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "background": {
    "scripts": [
      "src/scripts/background.js"
    ]
  },
  "permissions": [
    "bookmarks",
    "storage",
    "tabs"
  ],
  "icons": {
    "48": "src/icons/icon48.png",
    "96": "src/icons/icon96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab-bookmarks@semanticdata",
      "strict_min_version": "140.0"
    }
  }
}